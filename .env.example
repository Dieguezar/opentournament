# OpenTournament - Variables de entorno de ejemplo
# Copia este archivo a .env y ajusta los valores.
# Ningún valor real de secretos debe commitearse.

# --- General ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
TZ=UTC
LOG_LEVEL=info

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgres://opentournament:opentournament@localhost:5432/opentournament

# --- Sesiones / seguridad ---
# Generar con: openssl rand -hex 32
SESSION_SECRET=change-me-32-bytes-random-hex
JWT_SECRET=change-me-32-bytes-random-hex
SESSION_TTL_HOURS=168
CSRF_SECRET=change-me-32-bytes-random-hex

# --- Correo (SMTP) ---
# Si SMTP no está configurado, los correos se escriben en el log
# y la verificación de correo puede desactivarse (ALLOW_UNVERIFIED_EMAILS=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenTournament <no-reply@example.com>
SMTP_SECURE=false
ALLOW_UNVERIFIED_EMAILS=false

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=${API_URL}/api/v1/auth/discord/callback

# --- Discord Bot ---
DISCORD_BOT_TOKEN=
DISCORD_BOT_ENABLED=false

# --- Almacenamiento (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=opentournament
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=${API_URL}/files

# --- Límites ---
MAX_EVIDENCE_SIZE_MB=10
MAX_EVIDENCE_FILES_PER_SUBMISSION=5
RATE_LIMIT_GLOBAL_PER_MIN=300

# --- Datos de demostración ---
SEED_DEMO_DATA=false
