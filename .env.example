# OpenTournament - Variables de entorno de ejemplo
# Copia este archivo a .env y ajusta los valores.
# Ningún valor real de secretos debe commitearse.

# --- General ---
# NODE_ENV se usa con pnpm; los contenedores usan el perfil separado y seguro de Compose.
NODE_ENV=development
COMPOSE_NODE_ENV=production
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
TZ=UTC
LOG_LEVEL=info

# --- Imágenes de aplicación ---
# "build" compila el checkout local. Una release reemplaza estas imágenes por las de GHCR
# y usa IMAGE_PULL_POLICY=always; consulta docs/SELF_HOSTING.md.
API_IMAGE=opentournament-api:local
WEB_IMAGE=opentournament-web:local
IMAGE_PULL_POLICY=build

# --- Puertos publicados por Docker Compose ---
# Cambia solo los que ya estén ocupados en el host.
POSTGRES_HOST_PORT=5432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=4000
WEB_HOST_PORT=3000
# Interfaz web del Mailpit opcional (`docker compose --profile mail up -d`).
MAILPIT_UI_HOST_PORT=8025

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=opentournament
POSTGRES_PASSWORD=opentournament
POSTGRES_DB=opentournament
DATABASE_URL=postgres://opentournament:opentournament@localhost:5432/opentournament
DATABASE_URL_DOCKER=postgres://opentournament:opentournament@postgres:5432/opentournament

# --- Sesiones / seguridad ---
# Generar con: openssl rand -hex 32
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
SESSION_TTL_HOURS=168

# --- Correo (SMTP) ---
# Si SMTP no está configurado, los correos se escriben en el log
# y la verificación de correo puede desactivarse (ALLOW_UNVERIFIED_EMAILS=true).
# Para evaluar correo localmente con Mailpit usa SMTP_HOST=mailpit, SMTP_PORT=1025
# y SMTP_SECURE=false. No uses Mailpit para correo de producción.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=OpenTournament <no-reply@example.com>
SMTP_SECURE=false
ALLOW_UNVERIFIED_EMAILS=false

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# --- Discord Bot ---
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_NOTIFY_WEBHOOK_URL=

# --- Almacenamiento (S3-compatible) ---
# Con MinIO local, estas mismas credenciales se aplican al servidor y a la API.
S3_ENDPOINT=http://localhost:9000
S3_ENDPOINT_DOCKER=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=opentournament
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Límites ---
MAX_EVIDENCE_SIZE_MB=10
MAX_EVIDENCE_FILES_PER_SUBMISSION=5
RATE_LIMIT_GLOBAL_PER_MIN=300

# --- Datos de demostración ---
SEED_DEMO_DATA=false
