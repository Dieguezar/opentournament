{
  "name": "opentournament",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma open source para crear, administrar y publicar torneos de esports.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@opentournament/api",
    "dev:web": "turbo run dev --filter=@opentournament/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test tests/config/compose.test.mjs",
    "test:unit": "turbo run test --filter=@opentournament/*",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @opentournament/database db:generate",
    "db:migrate": "pnpm --filter @opentournament/database db:migrate",
    "db:seed": "pnpm --filter @opentournament/database db:seed",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
