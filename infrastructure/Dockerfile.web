FROM node:22-alpine AS builder

RUN corepack enable

ARG API_URL=http://api:4000
ENV API_URL=$API_URL

WORKDIR /app

COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc eslint.base.mjs eslint.config.mjs ./
COPY apps/web/package.json apps/web/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/bracket-ui/package.json packages/bracket-ui/
COPY pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm --filter @opentournament/web build

FROM node:22-alpine

RUN corepack enable

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app ./

EXPOSE 3000
CMD ["pnpm", "--filter", "@opentournament/web", "start"]
